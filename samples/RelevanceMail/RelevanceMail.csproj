<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <StyloMailSourceRoot Condition="'$(StyloMailSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../../stylomail</StyloMailSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Mostlylucid.Relevance.Sqlite/Mostlylucid.Relevance.Sqlite.csproj" />
    <ProjectReference Include="$(StyloMailSourceRoot)/src/StyloMail.Core/StyloMail.Core.csproj" />
  </ItemGroup>
  <Target Name="RequireStyloMailCheckout" BeforeTargets="CollectPackageReferences" Condition="!Exists('$(StyloMailSourceRoot)/src/StyloMail.Core/StyloMail.Core.csproj')">
    <Error Text="This integration sample uses the real StyloMail.Core contracts. Check out scottgal/stylomail alongside mostlylucidweb, or set -p:StyloMailSourceRoot=/path/to/stylomail." />
  </Target>
</Project>
