{
  "scripts": {
    "clean": "rimraf ./.tmp ./wwwroot/css/dist ./wwwroot/js/dist",
    "copy:static": "cpx \"src/css/{raleway,easymde-overrides}.css\" \"wwwroot/css/dist\"",
    "copy:highlight": "cpx \"src/css/highlight/*.min.css\" \"wwwroot/css/highlight\"",
    "vendor:icons": "node scripts/vendor-boxicons.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "copy:all": "npm-run-all vendor:icons check:icons --parallel copy:static copy:highlight",
    "copy:watch": "cpx \"src/css/{raleway,easymde-overrides}.css\" \"wwwroot/css/dist\" --watch & cpx \"src/css/highlight/*.min.css\" \"wwwroot/css/highlight\" --watch",
    "tw:dev": "postcss ./src/css/main.css -o ./wwwroot/css/dist/main.css",
    "tw:prod": "postcss ./src/css/main.css -o ./wwwroot/css/dist/main.css --no-map --verbose",
    "tw:watch": "postcss ./src/css/main.css -o ./wwwroot/css/dist/main.css --watch",
    "js:dev": "webpack --env development",
    "js:prod": "webpack --mode production",
    "js:watch": "webpack watch --mode development",
    "dev": "npm-run-all clean copy:all --parallel tw:dev js:dev",
    "watch": "npm-run-all clean copy:all --parallel copy:watch tw:watch js:watch",
    "build": "npm-run-all clean copy:all --parallel tw:prod js:prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.12",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "autoprefixer": "10.6.1",
    "babel-loader": "10.1.1",
    "babel-plugin-polyfill-corejs3": "1.0.0",
    "cpx2": "9.0.3",
    "css-loader": "7.1.5",
    "cssnano": "9.9.0",
    "daisyui": "^4.12.10",
    "happy-dom": "^21.0.4",
    "marked": "^18.1.1",
    "mini-css-extract-plugin": "^2.9.4",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.31",
    "postcss-cli": "12.0.0",
    "postcss-import": "^17.0.1",
    "postcss-prefix-selector": "^2.1.1",
    "puppeteer": "^25.16.0",
    "rimraf": "6.1.3",
    "style-loader": "4.0.0",
    "tailwindcss": "3.4.19",
    "terser-webpack-plugin": "^5.3.10",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-manifest-plugin": "^6.0.1"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@mostlylucid/mermaid-enhancements": "file:../mostlylucid-mermaid",
    "alpinejs": "^3.17.5",
    "boxicons": "^2.1.4",
    "core-js": "^3.51.0",
    "easymde": "2.21.0",
    "flatpickr": "^4.6.13",
    "highlight.js": "^11.10.0",
    "highlightjs-cshtml-razor": "^2.1.1",
    "html-to-image": "^1.11.13",
    "htmx.org": "^2.0.8",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "pele": "1.9.0",
    "regenerator-runtime": "^0.14.1",
    "svg-pan-zoom": "^3.6.2",
    "sweetalert2": "^11.26.3"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
