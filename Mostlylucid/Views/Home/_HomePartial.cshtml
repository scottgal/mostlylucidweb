@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Mostlylucid.Models.IndexPageViewModel
@inject Mostlylucid.Blog.ISiteContentService SiteContentService
@{
    // Edit Markdown/site/home-intro.md to change this; the text below is the fallback if it is missing
    var intro = SiteContentService.Get(Mostlylucid.Blog.SiteContentService.HomeIntro);
}
<section class="home-intro" aria-label="About Scott Galloway">
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <img src="/img/author.png?format=webp&quality=15" asp-append-version="true" width="64px" height="64px" class="h-16 w-16 mask mask-circle flex-shrink-0" alt="author"/>
        @if (intro != null)
        {
            <div class="intro-copy">
                @Html.Raw(intro.Html)
            </div>
        }
        else
        {
        <p class="font-body text-base text-blue-dark dark:text-white flex-1">
            <span class="font-semibold text-xl">Hi, I'm Scott Galloway</span> —
            I'm a consulting web / internet /  systems / full-cycle, full-stack developer (it's complicated 🤓) specializing in bringing 'AI' to the masses,  .NET Core, full-stack development, cloud, and search technologies. Former Microsoft ASP.NET Program Manager with 30+ years building web applications for Fortune 500 companies and startups.
            I share my <span class="font-semibold">work in progress (PERSONAL!)</span>  projects and how I build them.
            Available for contract, full-time, or consultancy work — <a href="mailto:scott.galloway+ml@gmail.com" class="text-blue-dark dark:text-blue hover:underline">get in touch</a>.
            Code on <a href="https://github.com/scottgal/mostlylucidweb" class="text-blue-dark dark:text-blue hover:underline">GitHub</a> |
            Feedback on <a href="https://hachyderm.io/@("@")scottgal@("@")hachyderm.io" class="text-blue-dark dark:text-blue hover:underline">Mastodon</a>
        </p>
        }
    </div>
</section>

<div class="home-columns">
<section class="home-articles" aria-label="Latest articles">
<partial name="_PopularPost" />

<div class="article-heading"><div><h2>Latest articles</h2></div><a href="/blog">All articles <span aria-hidden="true">→</span></a></div>

<div>
    <!-- Filter Bar (outside #content, not swapped) -->
    <div class="flex justify-center mb-4 print:!hidden">
        <partial name="_FilterBar" model="Model.Posts"/>
    </div>

    <!-- Blog Posts List -->
    <partial name="_BlogSummaryList" model="Model.Posts"/>
</div>
</section>
<aside class="project-sidebar" aria-label="Projects and GitHub activity">
    <partial name="_CurrentProjects" />
    <details class="repository-widget" open>
        <summary><i class="bx bxl-github" aria-hidden="true"></i> What I'm working on</summary>
        <div hx-get="/projects/activity" hx-trigger="load" hx-swap="innerHTML" aria-live="polite">
            <p class="repository-note">Loading recent public work… <a href="https://github.com/scottgal?tab=repositories">Browse repositories</a></p>
        </div>
    </details>
</aside>
</div>
