@using Mostlylucid.Models.Search
@using Mostlylucid.Shared.Helpers
@using Mostlylucid.Services.Markdown
@model dynamic
@{
    var targetUrl = Context.Request.Path.Value ?? "/";
    var isSearchPage = targetUrl.StartsWith("/search", StringComparison.OrdinalIgnoreCase);
    var postList = isSearchPage ? ((SearchResultsModel)Model).SearchResults : (Mostlylucid.Models.Blog.PostListViewModel)Model;
    var allCategories = isSearchPage ? ((SearchResultsModel)Model).AllCategories : postList.AllCategories;
    var query = Context.Request.Query;
    var language = query["language"].FirstOrDefault() ?? (isSearchPage ? "" : "en");
    var order = query["order"].FirstOrDefault()
        ?? (query.ContainsKey("orderBy") ? $"{query["orderBy"]}_{query["orderDir"].FirstOrDefault() ?? "desc"}" : "date_desc");
    var resetUrl = isSearchPage ? "/search?query=" + Uri.EscapeDataString(query["query"].ToString()) : targetUrl;
}
<section class="filter-panel" aria-label="Filter articles" data-filter-panel>
    <details open="@(targetUrl != "/")">
        <summary><span><i class="bx bx-filter-alt" aria-hidden="true"></i> Find your next read</span><span class="filter-toggle-hint">Filters <i class="bx bx-chevron-down" aria-hidden="true"></i></span></summary>
        <form action="@targetUrl" method="get" data-blog-filters
              hx-get="@targetUrl" hx-target="#content" hx-swap="outerHTML show:none"
              hx-trigger="submit, change" hx-push-url="true" hx-sync="#contentcontainer:replace">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@(postList?.PageSize > 0 ? postList.PageSize : 10)" />
            @if (isSearchPage)
            {
                <input type="hidden" name="query" value="@query["query"]" data-filter-query />
                <input type="hidden" name="dateRange" value="Custom" />
            }
            <label for="categorySelect">Topic
                <select id="categorySelect" name="category">
                    <option value="">All topics</option>
                    @foreach (var category in allCategories ?? new List<Mostlylucid.Shared.Models.CategoryWithCount>())
                    {
                        <option value="@category.Name" selected="@(query["category"] == category.Name)">@category.Name (@category.PostCount)</option>
                    }
                </select>
            </label>
            <label for="languageSelect">Language
                <select id="languageSelect" name="language">
                    @if (isSearchPage)
                    {
                        <option value="" selected="@(language == "")">All languages</option>
                    }
                    @foreach (var code in LanguageConverter.LanguageMap.Keys.OrderBy(code => code.ConvertCodeToLanguage()))
                    {
                        <option value="@code" selected="@(language == code)">@code.ConvertCodeToLanguage()</option>
                    }
                </select>
            </label>
            <label for="startDate">From
                <input id="startDate" name="startDate" type="date" value="@query["startDate"]" />
            </label>
            <label for="endDate">Until
                <input id="endDate" name="endDate" type="date" value="@query["endDate"]" />
            </label>
            <label for="orderSelect">Sort by
                <select id="orderSelect" name="order">
                    @if (isSearchPage)
                    {
                        <option value="relevance" selected="@(order == "relevance")">Best match</option>
                    }
                    <option value="date_desc" selected="@(order == "date_desc")">Newest first</option>
                    <option value="date_asc" selected="@(order == "date_asc")">Oldest first</option>
                    <option value="title_asc" selected="@(order == "title_asc")">Title A–Z</option>
                    <option value="title_desc" selected="@(order == "title_desc")">Title Z–A</option>
                </select>
            </label>
            <div class="filter-actions">
                <button type="submit" class="filter-apply">Apply</button>
                <a href="@resetUrl" data-filter-reset hx-get="@resetUrl" hx-target="#content" hx-swap="outerHTML show:none" hx-push-url="true" hx-sync="#contentcontainer:replace">Reset</a>
            </div>
        </form>
        <p class="filter-summary" id="filterSummary" aria-live="polite"></p>
    </details>
</section>
