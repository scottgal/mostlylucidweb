@inject Mostlylucid.Blog.ISiteContentService SiteContentService
@{
    var callout = SiteContentService.Get(Mostlylucid.Blog.SiteContentService.ResumeCallout);
}
@if (callout != null)
{
    <aside class="resume-callout print:!hidden" aria-label="Résumés and lucidRESUME" data-resume-callout>
        <div class="container mx-auto editable-callout">@Html.Raw(callout.Html)</div>
    </aside>
}
