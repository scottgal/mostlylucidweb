@model Mostlylucid.Models.BaseViewModel
@inject Mostlylucid.Blog.BlogConfig BlogConfig
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="IE=edge,chrome=1" http-equiv="X-UA-Compatible" />
    <meta
        content="width=device-width, initial-scale=1, shrink-to-fit=no"
        name="viewport"
    />
    <title>@ViewBag.Title</title>

    <!-- RSS Feed Autodiscovery -->
    <link rel="alternate" type="application/rss+xml"
          title="mostlylucid.net RSS Feed"
          href="https://@Context.Request.Host/rss" />
    <link rel="alternate" type="application/atom+xml"
          title="mostlylucid.net Atom Feed"
          href="https://@Context.Request.Host/atom" />

    <link rel="prefetch" href="https://accounts.google.com/gsi/client"/>

    @{
        var currentUrl = $"https://{Context.Request.Host}{Context.Request.Path}";
        var defaultDescription = "Scott Galloway is a lead developer and software engineer with a passion for building web applications.";
        var pageDescription = ViewBag.Description as string ?? defaultDescription;
        var defaultImage = "https://mostlylucid.net/img/social2.jpg";
        var pageImage = ViewBag.OgImage as string ?? defaultImage;
    }

    <!-- Canonical URL -->
    <link rel="canonical" href="@currentUrl" />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content="@currentUrl" id="metaOgUrl">
    <meta property="og:type" content="@(ViewBag.OgType ?? "website")">
    <meta property="og:title" content="@ViewBag.Title">
    <meta property="og:description" content="@pageDescription">
    <meta property="og:image" content="@pageImage">
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="mostlylucid" />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary">
    <meta property="twitter:domain" content="mostlylucid.net">
    <meta property="twitter:url" content="@currentUrl" id="metaTwitterUrl">
    <meta name="twitter:title" content="@ViewBag.Title">
    <meta name="twitter:description" content="@pageDescription">
    <meta name="twitter:image" content="@pageImage">

    <!-- Meta Description -->
    <meta name="description" content="@pageDescription" />

    <!-- Site-wide Structured Data -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebSite",
        "name": "mostlylucid",
        "url": "https://www.mostlylucid.net",
        "description": "Technical blog covering ASP.NET Core, C#, Entity Framework, HTMX, Docker, and modern web development.",
        "potentialAction": {
            "@@type": "SearchAction",
            "target": {
                "@@type": "EntryPoint",
                "urlTemplate": "https://www.mostlylucid.net/search?query={search_term_string}"
            },
            "query-input": "required name=search_term_string"
        },
        "publisher": {
            "@@type": "Person",
            "name": "Scott Galloway",
            "url": "https://www.mostlylucid.net/blog/aboutme",
            "sameAs": [
                "https://github.com/scottgal",
                "https://twitter.com/scottgal",
                "https://www.linkedin.com/in/scottgalloway/"
            ]
        }
    }
    </script>

    <!-- Article metadata for blog posts -->
    @if (ViewBag.PublishedDate != null)
    {
        <meta property="article:published_time" content="@(((DateTime)ViewBag.PublishedDate).ToString("yyyy-MM-ddTHH:mm:ssZ"))" />
        <meta property="article:author" content="Scott Galloway" />
    }
    <link rel="icon" type="image/png" href="/img/smalllogo.svg" />

    <script src="https://accounts.google.com/gsi/client"  data-cfasync="false" async defer></script>
    <!-- Boxicons are bundled into main.css and served from /fonts - no CDN dependency -->
    <link rel="preload" href="/fonts/boxicons.woff2" as="font" type="font/woff2" crossorigin />
    <link
        href="/css/dist/main.css" asp-append-version="true"
        media="screen, print"
        rel="stylesheet"
    />
    <!-- Highlight.js themes now bundled in main.css - no separate requests needed -->
    <link rel="manifest" href="~/manifest.json" />
</head>
<body
    data-blog-mode="@BlogConfig.Mode"
    x-data="globalSetup()"
    x-init="themeInit()"
    :class="isMobileMenuOpen ? 'max-h-screen overflow-hidden relative' : ''"
    class="bg-custom-light-bg dark:bg-custom-dark-bg ">
<partial name="_Toast"  />
<a class="skip-link" href="#contentcontainer">Skip to content</a>
<partial name="_ResumeCallout" />
<header class="site-header sticky top-0 z-40 container mx-auto print:!hidden" id="header">
    <div class="site-header-inner">
        <a href="/" class="header-brand" aria-label="mostlylucid home"
           hx-controller="Home" hx-action="Index" hx-get hx-target="#contentcontainer"
           hx-swap="show:window:top" hx-push-url="true" hx-headers='{"homerequest": "true"}'>
            <img src="/img/logo.svg" asp-append-version="true" width="176" height="30"
                 alt="mostlylucid" class="site-logo" :class="{ 'img-filter-dark': !isDarkMode }" />
        </a>

        <div class="header-search">
            <partial name="_TypeAhead" />
        </div>

        <nav class="site-navigation" aria-label="Main navigation">
            <a href="/search" class="header-control mobile-search" aria-label="Search articles" title="Search articles"><i class="bx bx-search" aria-hidden="true"></i></a>
            <a href="/software" class="header-control" hx-boost="true" hx-target="#contentcontainer"
               hx-swap="show:window:top" aria-label="Software" data-umami-event="Software Click" title="Software">
                <i class="bx bx-code-block" aria-hidden="true"></i><span class="header-link-label">Software</span>
            </a>
            <a asp-action="Index" asp-controller="Contact" class="header-control" hx-boost="true"
               hx-target="#contentcontainer" hx-swap="show:window:top" aria-label="Contact"
               data-umami-event="Contact Click" title="Contact">
                <i class="bx bx-envelope" aria-hidden="true"></i><span class="header-link-label">Contact</span>
            </a>
            <a href="https://www.nuget.org/profiles/mostlylucid" class="header-control header-wide-link"
               target="_blank" rel="noopener noreferrer" data-umami-event="NuGet Click">NuGet</a>
        </nav>

        <div class="header-utilities">
            <a href="https://github.com/scottgal/" class="header-control header-wide-link" aria-label="GitHub" title="GitHub"
               target="_blank" rel="noopener noreferrer"><i class="bx bxl-github" aria-hidden="true"></i></a>
            <a href="/rss" class="header-control header-rss" aria-label="RSS feed" title="RSS feed"><i class="bx bx-rss" aria-hidden="true"></i></a>
            <div class="header-auth">
                @if (Model?.Authenticated == true)
                {
                    <a data-logout-link asp-action="Logout" asp-controller="Login" class="header-control" aria-label="Sign out" title="Sign out">
                        @if (Model.AvatarUrl != null)
                        {
                            <img src="@Model.AvatarUrl" width="28" height="28" class="rounded-full" alt="@Model.Name" />
                        }
                        else
                        {
                            <i class="bx bx-log-out" aria-hidden="true"></i>
                        }
                    </a>
                }
                else
                {
                    <div id="google_button" title="Sign in with Google"></div>
                }
            </div>
            <button type="button" class="header-control theme-toggle" x-on:click="themeSwitch()"
                    :aria-label="isDarkMode ? 'Switch to light theme' : 'Switch to dark theme'">
                <i class="bx" :class="isDarkMode ? 'bxs-sun' : 'bxs-moon'" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</header>
@if (BlogConfig.Mode == Mostlylucid.Blog.BlogMode.Database)
{
    <div id="announcement-container" hx-get="/announcement/banner" hx-trigger="load" hx-swap="innerHTML"></div>
}
<span class="hidden btn btn-sm btn-active btn-disabled select select-primary select-sm
        text-sm text-gray-600 text-neutral-500 border rounded flex items-center
        justify-center min-w-[80px] pr-4 pt-0 mt-0 mr-2 btn-primary btn-outline
bg-white    dark:border-gray-600 dark:bg-gray-800 bg-gray-800
        dark:bg-blue-500 dark:border-blue-400 dark:text-white dark:hover:bg-blue-600 
        dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600 dark:hover:bg-gray-700
        dark:btn-accent dark:btn-outline dark:btn-disabled dark:btn-primary dark:btn-active gap-2 whitespace-nowrap cursor-pointer">
</span>
<main class="container mx-auto" id="contentcontainer" tabindex="-1" hx-history-elt>
    @RenderBody()
</main>
<div class="container pb-8 mx-auto print:hidden">
    <div
        class="flex flex-col items-center justify-between  sm:flex-row sm:py-2">
        <div class="mr-auto flex flex-col items-center sm:flex-row">
            <a href="/" hx-controller="Home" hx-action="Index" hx-swap="show:window:top" hx-target="#contentcontainer" hx-push-url="true" hx-get hx-headers='{"homerequest": "true"}' class="mr-auto sm:mr-6">
                <div class="svg-container">
                    <img src="/img/logo.svg" asp-append-version="true" width="180px" height="30px" alt="logo" :class="{ 'img-filter-dark': !isDarkMode }"/>
                </div>
            </a>
<p class="pt-5 font-body font-light text-primary dark:text-white sm:pt-0">
    &copy; @DateTime.UtcNow.Year Scott Galloway — 
    <a href="https://unlicense.org" target="_blank" rel="noopener noreferrer">Unlicense</a> — 
    All content and source code on this site is free to use, copy, modify, and sell.
</p>

        </div>
        <partial name="_Socials"/>
    </div>

</div>
<noscript>
    <style>
        [x-cloak] {
            display: block !important;
        }
    </style>
</noscript>
<script src="~/js/dist/main.js" asp-append-version="true"  data-cfasync="false"> </script>
<script src="@(ViewBag.UmamiPath + "/" + ViewBag.UmamiScript)" data-website-id="@ViewBag.UmamiWebsiteId"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
