@model string
@{
    var url = Url.Action("Category", "Blog", new { category = Model });
}
<a hx-boost="false" 
   hx-get="@url"
   hx-push-url="true"
   hx-target="#contentcontainer" class="cursor-pointer">
    <span class="inline-block rounded-full bg-blue-light/20 dark:bg-gray-800/20 px-2 py-1 font-body text-sm text-black dark:text-white outline-1 outline outline-blue-light dark:outline-gray-700">@Model</span>
</a>