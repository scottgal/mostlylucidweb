@* A single search surface: input and submit share one border and background. *@
<div x-data="typeahead()" id="searchelement" x-on:click.outside="results = []" class="header-typeahead">
    <form action="/search" method="get" role="search" x-on:submit.prevent="goToSearch" class="header-search-form">
        <input type="search" name="query" x-model="query"
               x-on:input.debounce.200ms="search"
               x-on:keydown.down.prevent="moveDown" x-on:keydown.up.prevent="moveUp"
               x-on:keydown.enter.prevent="completeAndSearch"
               x-on:keydown.escape.prevent="results = []"
               placeholder="Search articles…" aria-label="Search articles" autocomplete="off"
               class="header-search-input" />
        <button type="submit" class="header-search-submit" title="Search" aria-label="Search">
            <i class="bx bx-search" aria-hidden="true"></i>
        </button>
    </form>
    <ul x-show="results.length > 0" x-cloak id="searchresults" class="header-search-results">
        <template x-for="(article, index) in results" :key="article.slug">
            <li>
                <a :href="'/blog/' + article.slug" x-on:mouseenter="highlightedIndex = index"
                   :class="{ 'is-highlighted': index === highlightedIndex }" x-text="article.title"></a>
            </li>
        </template>
    </ul>
</div>
