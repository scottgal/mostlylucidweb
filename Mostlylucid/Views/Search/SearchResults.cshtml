@model Mostlylucid.Models.Search.SearchResultsModel
@using Mostlylucid.Models.Search
@using Htmx

@{
    // Don't use layout for HTMX partial requests
    if (!Context.Request.IsHtmx())
    {
        Layout = "_Layout";
    }
    ViewBag.Title = "Search Results";
    ViewBag.Description = "Search through technical articles on ASP.NET Core, C#, Entity Framework, and web development. Find tutorials, guides, and solutions.";
}

<form class="search-form" action="/search" method="get"
      hx-get="/search" hx-target="#contentcontainer" hx-swap="innerHTML show:none"
      hx-push-url="true" hx-sync="#contentcontainer:replace"
      hx-trigger="submit, input changed delay:500ms from:#searchQuery"
      hx-include="#categorySelect, #languageSelect, #startDate, #endDate, #orderSelect">
    <label for="searchQuery">Search the engineering notebook</label>
    <div>
        <input type="search" name="query" id="searchQuery" value="@Model.Query"
               placeholder="Articles, tools, and ideas…" />
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="dateRange" value="Custom" />
        <button type="submit" class="filter-apply">Search</button>
    </div>
</form>

<!-- Filter Bar - below search, always visible -->
<div class="flex justify-center my-4 print:!hidden">
    <partial name="_FilterBar" model="Model"/>
</div>

@if(Model.Query?.Length > 0)
{
    <partial name="_SearchResultsPartial" model="Model.SearchResults"></partial>
}
else
{
    <div id="content" class="pt-2 h-1/2 text-center text-lg text-black dark:text-white" data-search-page>
        Please enter a search term.
    </div>
}
